<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>Cotización {{ e.nombre }}{% if c.cliente_nombre %} - {{ c.cliente_nombre }}{% endif %}</title>
<style>
  @page { size: A4; margin: 14mm; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #fff; color: #000; font-family: Arial, Helvetica, sans-serif; font-size: 13px; }
  .hoja { width: 700px; margin: 0 auto; padding: 24px 0; }
  .b { font-weight: bold; }

  /* Membrete */
  .membrete { display: flex; align-items: center; gap: 28px; }
  .membrete img { width: 112px; height: auto; display: block; }
  .membrete .giro { flex: 1; text-align: center; font-size: 12.5px; line-height: 1.35; padding: 0 6px; }
  .direccion { margin-left: 140px; border-bottom: 1px solid #9bb7d4; text-align: center; font-weight: bold; padding: 8px 0 2px; }
  .direccion div + div { margin-top: 3px; }

  /* Datos del cliente */
  table.datos { margin: 6px 0 0 50px; border-collapse: collapse; width: calc(100% - 50px); }
  table.datos td { padding: 2px 0; vertical-align: baseline; }
  table.datos td.k { font-weight: bold; width: 96px; font-size: 14px; }
  table.datos td.v { font-size: 13.5px; }
  table.datos td.k2 { font-weight: bold; text-align: right; padding-right: 26px; }

  h1.titulo { margin: 14px 0 6px 0; font-size: 14px; letter-spacing: .5px; }

  /* Tabla de ítems */
  table.items, table.pie { border-collapse: collapse; width: 100%; table-layout: fixed; }
  table.items td, table.items th { border: 1px solid #000; padding: 1px 4px; height: 17px; }
  table.items { border: 2px solid #000; }
  col.c-cant { width: 10.5%; } col.c-desc { width: 63%; } col.c-pu { width: 13%; } col.c-pt { width: 13.5%; }
  .gris { background: #808080; }
  table.items th { background: #808080; font-size: 11px; text-align: center; line-height: 1.1; }
  table.items th.cot { font-size: 13px; vertical-align: bottom; }
  table.items td.cant { text-align: center; }
  table.items td.num { text-align: right; }
  table.items td.centro { text-align: center; font-weight: bold; }
  table.items tr.sub td { background: #808080; font-weight: bold; border-top: 2px solid #000; }

  /* Pie: forma de pago + total */
  table.pie td { padding: 1px 4px; height: 19px; }
  table.pie td.celda { border: 1px solid #000; }
  table.pie td.celda.gris { font-weight: bold; }
  table.pie .num { text-align: right; font-weight: bold; }
  table.pie .pago { font-weight: bold; }

  .entrega { margin: 16px 0 0 38px; text-align: center; font-weight: bold; width: 410px; line-height: 1.35; }
  .garantia { margin-top: 4px; }
  .garantia .t { font-weight: bold; }
  .firma { margin: 44px 0 0 130px; line-height: 1.7; }
  .firma .quien { font-weight: bold; }
  .sin-valor { color: #b00; font-style: italic; }

  @media print { .hoja { padding: 0; } }
</style>
</head>
<body>
<div class="hoja">

  <div class="membrete">
    {% if logo %}<img src="{{ logo }}" alt="{{ e.nombre }}">{% endif %}
    <div class="giro">{{ e.giro }}</div>
  </div>
  <div class="direccion">
    <div>DIRECCION :{{ e.direccion }}</div>
    <div>TELEFONO: {{ e.telefono }}</div>
  </div>

  <table class="datos">
    <tr><td class="k">{{ e.ciudad_emision }},</td><td class="v b" colspan="3">{{ c.fecha }}</td></tr>
    <tr><td class="k">CLIENTE:</td><td class="v" colspan="3">{{ c.cliente_nombre }}</td></tr>
    <tr>
      <td class="k">ATN:</td><td class="v">{{ c.cliente_atencion }}</td>
      <td class="k2">TELEFONO:</td><td class="v">{{ c.cliente_telefono }}</td>
    </tr>
    <tr><td class="k">DIRECCION:</td><td class="v" colspan="3">{{ c.cliente_direccion }}</td></tr>
    <tr><td class="k">CIUDAD:</td><td class="v" colspan="3">{{ c.cliente_ciudad }}</td></tr>
  </table>

  <h1 class="titulo">COTIZACIÓN</h1>

  <table class="items">
    <colgroup><col class="c-cant"><col class="c-desc"><col class="c-pu"><col class="c-pt"></colgroup>
    <thead>
      <tr><th>CANTIDAD</th><th class="cot">COTIZACION</th><th>PRECIO<br>UNITARIO</th><th>PRECIO<br>TOTAL</th></tr>
      <tr><th class="gris"></th><th class="gris" style="font-weight:normal;font-size:13px">DESCRIPCION</th><th class="gris"></th><th class="gris"></th></tr>
    </thead>
    <tbody>
      {% if c.titulo_trabajo %}
      <tr><td></td><td class="centro">{{ c.titulo_trabajo }}</td><td></td><td></td></tr>
      {% endif %}
      {% for l in c.lineas %}
      <tr>
        <td class="cant">{{ l.cantidad | qty }}</td>
        <td>{{ l.descripcion }}</td>
        <td class="num">{{ l.precio_unitario | money }}</td>
        <td class="num">{{ l.total | money }}</td>
      </tr>
      {% endfor %}
      {% for o in c.observaciones %}
      <tr><td></td><td>{{ o }}</td><td></td><td></td></tr>
      {% endfor %}
      {% for _ in range(filas_vacias) %}
      <tr><td></td><td></td><td></td><td></td></tr>
      {% endfor %}
      <tr class="sub"><td colspan="3">SUBTOTAL</td><td class="num">{{ c.subtotal | money }}</td></tr>
    </tbody>
  </table>

  <table class="pie">
    <colgroup><col class="c-cant"><col class="c-desc"><col class="c-pu"><col class="c-pt"></colgroup>
    {% if c.iva_porcentaje > 0 %}
    <tr>
      <td colspan="2" class="pago">{% if c.forma_pago %}FORMA DE PAGO: {{ c.forma_pago }}{% endif %}</td>
      <td class="celda gris">IVA {{ c.iva_porcentaje | qty }}%</td>
      <td class="celda num">{{ c.iva | money }}</td>
    </tr>
    {% else %}
    <tr>
      <td colspan="2" class="pago">{% if c.forma_pago %}FORMA DE PAGO: {{ c.forma_pago }}{% endif %}</td>
      <td class="celda gris"></td><td class="celda"></td>
    </tr>
    {% endif %}
    <tr>
      <td colspan="2" class="pago" style="padding-left:80px">{% if c.saldo %}SALDO: {{ c.saldo }}{% endif %}</td>
      <td class="celda gris">TOTAL</td>
      <td class="celda num" style="border-width:2px">{{ c.total | money }}</td>
    </tr>
  </table>

  {% if c.tiempo_entrega %}
  <div class="entrega">TIEMPO DE ENTREGA: {{ c.tiempo_entrega }}</div>
  {% endif %}

  {% if c.garantia %}
  <div class="garantia"><div class="t">GARANTIA:</div><div>{{ c.garantia }}</div></div>
  {% endif %}

  <div class="firma">
    <div class="b">ATENTAMENTE:</div>
    <div style="margin-top:14px">{{ e.firmante }}</div>
    <div class="quien">{{ e.cargo }}</div>
  </div>

</div>
</body>
</html>
